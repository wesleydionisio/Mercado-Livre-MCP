# Copie para .env (fica fora do Git).

# Navegador (npm run browser). Proxy residencial do Brasil; {sid} vira o SID ou um sorteado.
# Exemplo DataImpulse: http://LOGIN__cr.br;sessttl.180;sessid.{sid}:SENHA@gw.dataimpulse.com:10000
PROXY_URL=
SID=

# Ponte para o mint com Claude (npm run bridge). Use uma das duas.
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_FILE=
BUDGET_USD=20
